# Copy to .env and keep your own secret (never commit .env).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# MAA App Portal (central login)
SSO_SECRET=change-me-to-a-long-shared-sso-secret
PORTAL_SYNC_SECRET=change-me-to-a-long-sync-secret
PORTAL_URL=http://localhost:5050

# Optional: first login on a fresh DB only (skipped if any users_auth row exists).
# Defaults if unset: admin@gmail.com / admin123
# BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=admin123
